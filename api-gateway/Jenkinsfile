pipeline {
    agent any

    environment {
        SERVICE_DIR = 'api-gateway'
        IMAGE_NAME = 'khawlarouiss/api-gateway'
        DOCKER_REGISTRY = 'https://index.docker.io/v1/'
        DOCKER_CREDENTIALS_ID = 'dockerlogin'
        KUBECONFIG_DEV = 'kubeconfig-dev'
        KUBECONFIG_PROD = 'kubeconfig-prod'
        DEV_NAMESPACE = 'dev'
        PROD_NAMESPACE = 'prod'
    }

    stages {

        stage('Compute Version') {
            when {
                changeset "${SERVICE_DIR}/**"
            }
            steps {
                script {
                    sh 'chmod +x scripts/version.sh'
                    env.VERSION = sh(
                        script: "./scripts/version.sh ${IMAGE_NAME} ${BRANCH_NAME}",
                        returnStdout: true
                    ).trim()
                    echo "Computed version: ${env.VERSION}"
                }
            }
        }

        stage('Build Maven') {
            when {
                changeset "${SERVICE_DIR}/**"
            }
            tools {
                maven 'Maven 3.9.11'
                jdk 'jdk17'
            }
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            when {
                changeset "${SERVICE_DIR}/**"
            }
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY, DOCKER_CREDENTIALS_ID) {
                        docker.build("${IMAGE_NAME}:${env.VERSION}", "${SERVICE_DIR}")
                    }
                }
            }
        }

        stage('Docker Push') {
            when {
                changeset "${SERVICE_DIR}/**"
            }
            steps {
                script {
                    docker.withRegistry(DOCKER_REGISTRY, DOCKER_CREDENTIALS_ID) {
                        def img = docker.image("${IMAGE_NAME}:${env.VERSION}")
                        img.push()
                        if (env.BRANCH_NAME == 'main') {
                            img.push('latest')
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                allOf {
                    changeset "${SERVICE_DIR}/**"
                    anyOf {
                        branch 'dev'
                        branch 'main'
                    }
                }
            }
            steps {
                script {
                    def overlay
                    def namespace
                    def kubeCredId

                    if (env.BRANCH_NAME == 'dev') {
                        overlay = 'dev'
                        namespace = DEV_NAMESPACE
                        kubeCredId = KUBECONFIG_DEV
                        echo "Deploying to DEV cluster"
                    } else if (env.BRANCH_NAME == 'main') {
                        overlay = 'prod'
                        namespace = PROD_NAMESPACE
                        kubeCredId = KUBECONFIG_PROD
                        echo "Deploying to PROD cluster"
                    }

                    withCredentials([file(credentialsId: kubeCredId, variable: 'KUBECONFIG')]) {
                        sh """
                        echo "Testing Kubernetes access..."
                        kubectl cluster-info
                        kubectl get nodes
                        kubectl get pods -A
                        """

                        sh """
                        kubectl create namespace ${namespace} --dry-run=client -o yaml | kubectl apply --validate=false -f -
                        """

                        sh """
                        for file in ${SERVICE_DIR}/k8s/*.yaml; do
                            sed "s/PLACEHOLDER/${VERSION}/g" \$file | kubectl apply -n ${namespace} -f -
                        done
                        """

                        sh """
                        DEPLOYMENT_NAME=${SERVICE_DIR}-${overlay}
                        if kubectl get deployment \$DEPLOYMENT_NAME -n ${namespace} > /dev/null 2>&1; then
                            echo "Rolling out deployment \$DEPLOYMENT_NAME..."
                            kubectl rollout status deployment/\$DEPLOYMENT_NAME -n ${namespace}
                        else
                            echo "Deployment \$DEPLOYMENT_NAME does not exist yet."
                        fi
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
            cleanWs()
        }
    }
}
